{
  "name": "selekt-dj-downloader",
  "productName": "Selekt DJ Downloader",
  "version": "1.1.0",
  "description": "Download tracks, sets and videos straight into your folders.",
  "author": "Patricio Escobar (Selekt DJ)",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win"
  },
  "dependencies": {
    "chokidar": "^3.6.0",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "yt-dlp-wrap": "^2.3.12"
  },
  "devDependencies": {
    "electron": "^44.10.2",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.selektdj.downloader",
    "productName": "Selekt DJ Downloader",
    "files": ["main.js", "preload.js", "renderer/**/*", "node_modules/**/*"],
    "asarUnpack": ["node_modules/ffmpeg-static/**", "node_modules/ffprobe-static/**"],
    "mac": { "target": ["dmg"], "category": "public.app-category.music", "icon": "build/icon.icns" },
    "win": { "target": ["nsis"], "icon": "build/icon.png" },
    "linux": { "target": ["AppImage"], "category": "AudioVideo", "icon": "build/icon.png" }
  }
}
